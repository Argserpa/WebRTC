#  Variables de entorno para docker-compose 
# Sobreescriben los valores por defecto definidos en docker-compose.yml.
# 

#  Streaming 
INPUT=/dev/video0            # dispositivo V4L2 de la cámara (/dev/video1 si es USB secundaria)
USE_NVENC=false              # true habilita el codificador hardware de NVIDIA
VIDEO_SCALE=1920:1080        # resolución de salida (valores menores alivian la carga de CPU)

# Duración de cada segmento de grabación en segundos.
# 1800 = 30 minutos. Cada segmento queda como un fichero .ts reproducible de forma independiente.
SEGMENT_DURATION=1800

#  Servidor TURN (opcional) 
# Solo hace falta cuando los espectadores están fuera de la LAN y el P2P directo
# queda bloqueado por un NAT simétrico. En red local basta con STUN. En principio
# no se usa
TURN_SERVER_HOST=192.168.1.45   # IP o hostname del servidor coturn
TURN_SERVER_PORT=3478            # puerto estándar TURN/STUN
TURN_SERVER_USER=turnuser        # usuario (tiene que coincidir con turnserver.conf)
TURN_SERVER_PASS=turnpass        # contraseña (ídem)
TURN_SERVER_REALM=yourdomain.com # realm (ídem)
